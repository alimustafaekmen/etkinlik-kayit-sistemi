# cp .env.example .env ile kopyalayın (.env depoya eklenmez). flask run bu dosyayı okur.
APP_ENV=development
SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin
DATABASE_PATH=data/events.db
SEED_DEMO_DATA=false
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Istanbul

